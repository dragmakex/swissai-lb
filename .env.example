# Bootstrap only. Add SwissAI upstream keys through the dashboard.
PORT=2455
SWISSAI_LB_DATA_DIR=~/.swissai-lb
# SWISSAI_LB_DATABASE_URL=postgresql+asyncpg://user:password@postgres/swissai_lb
# SWISSAI_LB_ENCRYPTION_KEY_FILE=/run/secrets/swissai-encryption.key
SWISSAI_LB_DASHBOARD_AUTH_MODE=standard
# Set through a secret mechanism for initial remote dashboard setup:
# SWISSAI_LB_DASHBOARD_BOOTSTRAP_TOKEN=<random-bootstrap-secret>
SWISSAI_LB_UPSTREAM_BASE_URL=https://api.swissai.svc.cscs.ch/v1
# Explicit anonymous inference from private LAN / Docker bridge peers.
# When dashboard client-key authentication is enabled, this never bypasses it.
SWISSAI_LB_PROXY_ALLOW_ANONYMOUS_LAN=false
# Plain HTTP upstream is for local fake-server tests only.
SWISSAI_LB_ALLOW_INSECURE_UPSTREAM=false
# Configure only the immediate reverse proxies you control.
# SWISSAI_LB_TRUSTED_PROXY_HOSTS=127.0.0.1,::1
